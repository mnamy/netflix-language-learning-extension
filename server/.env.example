# Free Groq key from https://console.groq.com/keys — no credit card.
GROQ_API_KEY=gsk_your-key-here
# Same public Supabase values as the extension / web app. Not the service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Your auth.users id. Required on Vercel. Optional locally.
ALLOWED_USER_ID=your-supabase-user-uuid
# GROQ_MODEL=openai/gpt-oss-20b
# PORT=8787
